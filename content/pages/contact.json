      "type": "html",
      "html": "<div class=\"container-fluid pt-5\">\n        <div class=\"container pt-5\">\n            <div class=\"row g-4\">\n                <div class=\"col-md-4 wow fadeIn\" data-wow-delay=\"0.1s\">\n                    <div class=\"d-flex align-items-center bg-light h-100 p-2\">\n                        <div class=\"btn-square flex-shrink-0 bg-primary\" style=\"width: 70px; height: 70px;\">\n                            <i class=\"fa fa-phone-alt fa-lg text-white\"></i>\n                        </div>\n                        <div class=\"px-3\">\n                            <h5 class=\"mb-1\">Call Us</h5>\n                            <a class=\"text-secondary text-decoration-none\" href=\"tel:+919811001900\">+91 981 1001\n                                900</a>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-md-4 wow fadeIn\" data-wow-delay=\"0.3s\">\n                    <div class=\"d-flex align-items-center bg-light h-100 p-2\">\n                        <div class=\"btn-square flex-shrink-0 bg-primary\" style=\"width: 70px; height: 70px;\">\n                            <i class=\"fa fa-envelope fa-lg text-white\"></i>\n                        </div>\n                        <div class=\"px-3\">\n                            <h5 class=\"mb-1\">Email Us</h5>\n                            <a class=\"text-secondary text-decoration-none\"\n                                href=\"mailto:thegroupomega@gmail.com\">thegroupomega@gmail.com</a>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-md-4 wow fadeIn\" data-wow-delay=\"0.5s\">\n                    <div class=\"d-flex align-items-center bg-light h-100 p-2\">\n                        <div class=\"btn-square flex-shrink-0 bg-primary\" style=\"width: 70px; height: 70px;\">\n                            <i class=\"fa fa-map-marker-alt fa-lg text-white\"></i>\n                        </div>\n                        <div class=\"px-3\">\n                            <h5 class=\"mb-1\">Visit Us</h5>\n                            <span class=\"text-secondary\">Plot S4 &amp; S5, Main Dwarka Expressway, Near, Daulatabad Chowk, opp. Pillar 109, Gurugram, Haryana 122006</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>"
    },
    {
      "type": "html",
      "html": "<div class=\"container-fluid py-5\">\n        <div class=\"container py-5\">\n            <div class=\"text-center wow fadeIn\" data-wow-delay=\"0.1s\">\n                <h2 class=\"h1 mb-5\">Have a Project in Mind? <span\n                        class=\"text-uppercase text-primary bg-light px-2\">Let's Talk</span></h2>\n            </div>\n            <div class=\"row justify-content-center\">\n                <div class=\"col-lg-7\">\n                    <p class=\"text-center mb-4\">Share a few details about your home, villa, apartment, or commercial\n                        space, and a member of our design team will get back to you within 24 hours to schedule your\n                        complimentary consultation.</p>\n                    <div class=\"wow fadeIn\" data-wow-delay=\"0.3s\">\n                        <div id=\"contact-form-status\" class=\"d-none mb-4\" role=\"status\" aria-live=\"polite\"></div>\n                        <form id=\"contact-form\" novalidate>\n                            \n                            <div class=\"d-none\" aria-hidden=\"true\">\n                                <label for=\"website\">Leave this field blank</label>\n                                <input type=\"text\" id=\"website\" name=\"website\" tabindex=\"-1\" autocomplete=\"off\">\n                            </div>\n                            <div class=\"row g-3\">\n                                <div class=\"col-md-6\">\n                                    <div class=\"form-floating\">\n                                        <input type=\"text\" class=\"form-control\" id=\"full_name\" name=\"full_name\"\n                                            placeholder=\"Your Full Name\" maxlength=\"150\" required>\n                                        <label for=\"full_name\">Full Name</label>\n                                        <div class=\"invalid-feedback\"></div>\n                                    </div>\n                                </div>\n                                <div class=\"col-md-6\">\n                                    <div class=\"form-floating\">\n                                        <input type=\"tel\" class=\"form-control\" id=\"phone_number\" name=\"phone_number\"\n                                            placeholder=\"Your Phone Number\" maxlength=\"20\" required>\n                                        <label for=\"phone_number\">Phone Number</label>\n                                        <div class=\"invalid-feedback\"></div>\n                                    </div>\n                                </div>\n                                <div class=\"col-12\">\n                                    <div class=\"form-floating\">\n                                        <input type=\"text\" class=\"form-control\" id=\"city\" name=\"city\"\n                                            placeholder=\"Your City\" maxlength=\"100\" required>\n                                        <label for=\"city\">City</label>\n                                        <div class=\"invalid-feedback\"></div>\n                                    </div>\n                                </div>\n                                <div class=\"col-12\">\n                                    <div class=\"form-floating\">\n                                        <textarea class=\"form-control\" placeholder=\"Tell us about your project\"\n                                            id=\"project_details\" name=\"project_details\" style=\"height: 150px\" required></textarea>\n                                        <label for=\"project_details\">Tell us about your project</label>\n                                        <div class=\"invalid-feedback\"></div>\n                                    </div>\n                                </div>\n                                <div class=\"col-12\">\n                                    <button class=\"btn btn-primary w-100 py-3\" type=\"submit\" id=\"contact-form-submit\">Send Message</button>\n                                </div>\n                            </div>\n                        </form>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>"
    }
  ],
