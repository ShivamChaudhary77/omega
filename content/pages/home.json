            "html": "<div class=\"hero-video\">\n        <video class=\"hero-video-bg\" autoplay muted loop playsinline\n            poster=\"/img/hero-slider-1.webp\" aria-hidden=\"true\">\n            <source src=\"/video/banner-video.mp4\" type=\"video/mp4\">\n        </video>\n        <div class=\"hero-video-content animated fadeIn\">\n            <h1 class=\"display-3 mb-4\">Luxury Interiors Crafted Around Your <span class=\"text-primary\">Lifestyle</span></h1>\n            <p class=\"mb-0\">The Omega Group designs and delivers bespoke residential and commercial interiors,\n                managing every stage from concept to final handover under one accountable roof.</p>\n        </div>\n        <div class=\"hero-video-scroll\">\n            <i class=\"bi bi-chevron-down\"></i>\n        </div>\n    </div>"
