    {
      "type": "html",
      "html": "<header class=\"lp-header sticky-top py-3\">\n        <div class=\"container d-flex align-items-center justify-content-between\">\n            <span class=\"d-inline-block brand-mark\">\n                <img class=\"brand-logo\" src=\"/img/logo.png\" alt=\"The Omega Group logo\" width=\"180\" height=\"25\">\n            </span>\n            <div class=\"d-flex align-items-center gap-3\">\n                <a href=\"tel:+919811001900\" class=\"lp-call d-none d-sm-inline-flex align-items-center\" data-cta=\"header-call\">\n                    <i class=\"fa fa-phone-alt me-2\"></i>+91 981 1001 900\n                </a>\n                <a href=\"#consult-form\" class=\"btn btn-primary px-3 px-md-4\" data-cta=\"header-get-quote\">Get Free Quote</a>\n            </div>\n        </div>\n    </header>"
    },
    {
      "type": "html",
      "html": "<section class=\"lp-hero\" data-section=\"hero\">\n        <div class=\"container\">\n            <div class=\"row g-5 align-items-center\">\n                <div class=\"col-lg-6\">\n                    <span class=\"text-uppercase text-primary fw-bold d-block mb-3\" style=\"letter-spacing: 2px;\">Free, No-Obligation Consultation</span>\n                    <h1 class=\"mb-4\">Turnkey Interior Design for Your Gurgaon Home, Planned Around a Real Budget</h1>\n                    <p class=\"mb-4\">Tell us about your space and we'll get back with a real scope and quote — not a generic price list. One team handles design, procurement, and execution end to end, so you're not coordinating vendors yourself.</p>\n                    <ul class=\"list-unstyled lp-trust-bullets mb-4\">\n                        <li><i class=\"fa fa-check-circle\"></i><span>10+ years designing homes &amp; offices across Gurgaon</span></li>\n                        <li><i class=\"fa fa-check-circle\"></i><span>90+ projects delivered, 90% completed on schedule</span></li>\n                        <li><i class=\"fa fa-check-circle\"></i><span>70+ quality checks run on every single project</span></li>\n                    </ul>\n                    <div class=\"d-flex flex-wrap gap-3\">\n                        <a href=\"#consult-form\" class=\"btn btn-primary py-3 px-4\" data-cta=\"hero-get-quote\">Get My Free Quote</a>\n                        <a href=\"tel:+919811001900\" class=\"btn btn-outline-primary py-3 px-4\" data-cta=\"hero-call\">\n                            <i class=\"fa fa-phone-alt me-2\"></i>Call Now\n                        </a>\n                    </div>\n                </div>\n                <div class=\"col-lg-6\">\n                    <div class=\"lp-hero-media position-relative\">\n                        <img src=\"/img/projects/godrej-meridien-tower-3-sector-106-gurgaon/godrej-meridien-tower-3-sector-106-gurgaon-banner.webp\"\n                             alt=\"Turnkey interior design delivered by The Omega Group in a Gurgaon high-rise apartment\"\n                             width=\"1200\" height=\"900\" fetchpriority=\"high\">\n                        <div class=\"about-badge bg-primary px-4 py-3\">\n                            <h4 class=\"text-white lh-base mb-0 about-badge-title\">Starts at ₹15 Lakhs+ for a Full Home</h4>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>"
    },
    {
      "type": "html",
      "html": "<section class=\"container-fluid py-5\" data-section=\"problem\">\n        <div class=\"container\">\n            <div class=\"text-center\">\n                <h2 class=\"h1 mb-5\">Most Interior Projects Go Wrong <span class=\"text-uppercase text-primary bg-light px-2\">Before Work Even Starts</span></h2>\n            </div>\n            <div class=\"row g-4 text-center\">\n                <div class=\"col-md-4\">\n                    <div class=\"icon-card\">\n                        <i class=\"fa fa-people-carry fa-3x mb-4\"></i>\n                        <h4>Too Many Vendors to Manage</h4>\n                        <p class=\"mb-0\">Separate carpenters, painters, electricians, and a designer who isn't on site — with no single person accountable when something goes wrong.</p>\n                    </div>\n                </div>\n                <div class=\"col-md-4\">\n                    <div class=\"icon-card\">\n                        <i class=\"fa fa-file-invoice-dollar fa-3x mb-4\"></i>\n                        <h4>Quotes That Don't Hold Up</h4>\n                        <p class=\"mb-0\">A low opening number that grows once material and labour are actually confirmed, instead of a detailed quote you can trust upfront.</p>\n                    </div>\n                </div>\n                <div class=\"col-md-4\">\n                    <div class=\"icon-card\">\n                        <i class=\"fa fa-hourglass-half fa-3x mb-4\"></i>\n                        <h4>Timelines That Keep Slipping</h4>\n                        <p class=\"mb-0\">No one flags a delay until it's already happened, leaving you to plan a move or possession date around guesswork.</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>"
    },
    {
      "type": "html",
      "html": "<section class=\"container-fluid py-5 bg-light\" data-section=\"solution\">\n        <div class=\"container\">\n            <div class=\"row g-5 align-items-center\">\n                <div class=\"col-lg-6\">\n                    <img class=\"img-fluid rounded\" loading=\"lazy\"\n                         src=\"/img/projects/krisumi-sector-36a-gurgaon/krisumi-sector-36a-gurgaon-02.webp\"\n                         alt=\"Turnkey interior execution by The Omega Group at Krisumi, Sector 36A, Gurgaon\"\n                         width=\"1200\" height=\"900\">\n                </div>\n                <div class=\"col-lg-6\">\n                    <h2 class=\"h1 mb-4\">One Accountable Team, From Concept to Handover</h2>\n                    <p class=\"mb-4\">Every project we take on is turnkey by default: design, material procurement, and on-site execution under one roof, so you never have to translate between a designer and a separate contractor.</p>\n                    <div class=\"row g-3\">\n                        <div class=\"col-sm-6\">\n                            <h6 class=\"mb-3\"><i class=\"fa fa-check text-primary me-2\"></i>Customised Design, No Templates</h6>\n                            <h6 class=\"mb-0\"><i class=\"fa fa-check text-primary me-2\"></i>Premium Material Sourcing</h6>\n                        </div>\n                        <div class=\"col-sm-6\">\n                            <h6 class=\"mb-3\"><i class=\"fa fa-check text-primary me-2\"></i>Single-Point Turnkey Execution</h6>\n                            <h6 class=\"mb-0\"><i class=\"fa fa-check text-primary me-2\"></i>Itemised, Transparent Quoting</h6>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>"
    },
    {
      "type": "html",
      "html": "<section class=\"lp-stat-band py-5\" data-section=\"stats\">\n        <div class=\"container\">\n            <div class=\"row g-4 text-center\">\n                <div class=\"col-6 col-lg-3 lp-stat\">\n                    <h3>10+</h3>\n                    <p>Years of Experience</p>\n                </div>\n                <div class=\"col-6 col-lg-3 lp-stat\">\n                    <h3>90+</h3>\n                    <p>Projects Delivered</p>\n                </div>\n                <div class=\"col-6 col-lg-3 lp-stat\">\n                    <h3>90%</h3>\n                    <p>On-Time Delivery Rate</p>\n                </div>\n                <div class=\"col-6 col-lg-3 lp-stat\">\n                    <h3>70+</h3>\n                    <p>Quality Checks Per Project</p>\n                </div>\n            </div>\n        </div>\n    </section>"
    },
    {
      "type": "html",
      "html": "<section class=\"container-fluid py-5\" data-section=\"process\">\n        <div class=\"container\">\n            <div class=\"text-center\">\n                <h2 class=\"h1 mb-5\">How a Project With Us <span class=\"text-uppercase text-primary bg-light px-2\">Actually Works</span></h2>\n            </div>\n            <div class=\"row g-4 lp-process\">\n                <div class=\"col-md-3 lp-process-step\">\n                    <div class=\"lp-process-num\">1</div>\n                    <h5>Free Consultation</h5>\n                    <p class=\"mb-0\">We understand your space, lifestyle, and budget — no cost, no obligation.</p>\n                </div>\n                <div class=\"col-md-3 lp-process-step\">\n                    <div class=\"lp-process-num\">2</div>\n                    <h5>Design &amp; Detailed Quote</h5>\n                    <p class=\"mb-0\">A concrete design direction and an itemised quote, confirmed in writing before work begins.</p>\n                </div>\n                <div class=\"col-md-3 lp-process-step\">\n                    <div class=\"lp-process-num\">3</div>\n                    <h5>Turnkey Execution &amp; QC</h5>\n                    <p class=\"mb-0\">Our own team executes on site, inspected against 70+ quality checks at every stage.</p>\n                </div>\n                <div class=\"col-md-3 lp-process-step\">\n                    <div class=\"lp-process-num\">4</div>\n                    <h5>Handover</h5>\n                    <p class=\"mb-0\">A completed space, on schedule 90% of the time, with warranty support after handover.</p>\n                </div>\n            </div>\n        </div>\n    </section>"
    },
    {
      "type": "html",
      "html": "<section class=\"container-fluid py-5 bg-light\" data-section=\"portfolio\">\n        <div class=\"container\">\n            <div class=\"text-center mb-4\">\n                <h2 class=\"h1 mb-3\">Real Projects, Real Gurgaon Addresses</h2>\n                <p class=\"mb-0\">A sample of societies and towers where our team has designed and executed full interior projects.</p>\n            </div>\n            <div class=\"text-center mb-5\">\n                <a class=\"lp-society-pill\" href=\"/project/krisumi-sector-36a-gurgaon/\">Krisumi, Sector 36A</a>\n                <a class=\"lp-society-pill\" href=\"/project/godrej-meridien-tower-3-sector-106-gurgaon/\">Godrej Meridien, Sector 106</a>\n                <a class=\"lp-society-pill\" href=\"/project/hero-homes-sector-104-gurgaon/\">Hero Homes, Sector 104</a>\n                <a class=\"lp-society-pill\" href=\"/project/sobha-2-bhk-sectr-108-gurgaon/\">SOBHA, Sector 108</a>\n                <a class=\"lp-society-pill\" href=\"/project/m3m-woodhsire-sector-107-gurgaon/\">M3M Woodshire</a>\n                <a class=\"lp-society-pill\" href=\"/project/puri-emerald-bay-sector-104-gurgaon/\">Puri Emerald Bay</a>\n                <a class=\"lp-society-pill\" href=\"/project/eldeco-county-villa-sonepat/\">Eldeco County Villa, Sonepat</a>\n            </div>\n            <div class=\"row g-3 lp-gallery-grid\">\n                <div class=\"col-6 col-md-4 col-lg-2\">\n                    <img loading=\"lazy\" src=\"/img/projects/krisumi-sector-36a-gurgaon/krisumi-sector-36a-gurgaon-02.webp\" alt=\"Living room interior at Krisumi, Sector 36A\" width=\"1200\" height=\"900\">\n                </div>\n                <div class=\"col-6 col-md-4 col-lg-2\">\n                    <img loading=\"lazy\" src=\"/img/projects/hero-homes-sector-104-gurgaon/hero-homes-sector-104-gurgaon-banner.webp\" alt=\"Interior design at Hero Homes, Sector 104\" width=\"1200\" height=\"900\">\n                </div>\n                <div class=\"col-6 col-md-4 col-lg-2\">\n                    <img loading=\"lazy\" src=\"/img/projects/sobha/sobha-04.webp\" alt=\"Apartment interior at SOBHA, Sector 108\" width=\"1200\" height=\"1200\">\n                </div>\n                <div class=\"col-6 col-md-4 col-lg-2\">\n                    <img loading=\"lazy\" src=\"/img/projects/m3m-woodshire/m3m-woodshire-banner.webp\" alt=\"Interior design at M3M Woodshire\" width=\"1200\" height=\"1200\">\n                </div>\n                <div class=\"col-6 col-md-4 col-lg-2\">\n                    <img loading=\"lazy\" src=\"/img/projects/puri-emerald-bay/puri-emerald-bay-banner.webp\" alt=\"Interior design at Puri Emerald Bay\" width=\"1024\" height=\"768\">\n                </div>\n                <div class=\"col-6 col-md-4 col-lg-2\">\n                    <img loading=\"lazy\" src=\"/img/projects/eldeco-county-villa-sonepat/eldeco-county-villa-sonepat-banner.webp\" alt=\"Villa interior at Eldeco County Villa, Sonepat\" width=\"1200\" height=\"675\">\n                </div>\n            </div>\n        </div>\n    </section>"
    },
    {
      "type": "html",
      "html": "<section class=\"container-fluid py-5\" data-section=\"testimonials\">\n        <div class=\"container\">\n            <div class=\"text-center mb-5\">\n                <h2 class=\"h1 mb-0\">Client <span class=\"text-uppercase text-primary bg-light px-2\">Love</span></h2>\n            </div>\n            <div class=\"row g-4\">\n                <div class=\"col-md-4\">\n                    <div class=\"icon-card text-start h-100\">\n                        <i class=\"fa fa-quote-left fa-2x mb-4\"></i>\n                        <p>The Omega Group listened to how our family actually lives before drawing a single layout. The result feels curated but never staged, and the execution was handled without a single missed deadline.</p>\n                        <h5 class=\"mb-0\">Rohan Mehta, Villa Owner</h5>\n                    </div>\n                </div>\n                <div class=\"col-md-4\">\n                    <div class=\"icon-card text-start h-100\">\n                        <i class=\"fa fa-quote-left fa-2x mb-4\"></i>\n                        <p>We never had to manage a single vendor ourselves. From design to the final coat of paint, The Omega Group's team took full ownership, and the finish quality exceeded what we expected.</p>\n                        <h5 class=\"mb-0\">Ananya Iyer, Apartment Owner</h5>\n                    </div>\n                </div>\n                <div class=\"col-md-4\">\n                    <div class=\"icon-card text-start h-100\">\n                        <i class=\"fa fa-quote-left fa-2x mb-4\"></i>\n                        <p>The design team understood our brand identity and translated it into a workspace our clients and employees both comment on. Communication throughout the project was clear and consistent.</p>\n                        <h5 class=\"mb-0\">Karan Shah, Business Owner</h5>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>"
    },
    {
      "type": "html",
      "html": "<section class=\"container-fluid py-5 bg-light\" id=\"consult-form\" data-section=\"form\">\n        <div class=\"container\">\n            <div class=\"row justify-content-center\">\n                <div class=\"col-lg-8\">\n                    <div class=\"text-center mb-5\">\n                        <h2 class=\"h1 mb-3\">Get Your Free Design Consultation</h2>\n                        <p class=\"mb-0\">Takes under a minute. A real member of our design team calls back — no automated sales funnel.</p>\n                    </div>\n                    <div class=\"lp-form-card\">\n                        <div class=\"lp-form-progress\" aria-hidden=\"true\">\n                            <span id=\"lp-progress-1\" class=\"is-done\"></span>\n                            <span id=\"lp-progress-2\"></span>\n                            <span id=\"lp-progress-3\"></span>\n                        </div>\n\n                        <div id=\"lp-form-status\" class=\"mb-4 d-none\" role=\"alert\"></div>\n\n                        <form id=\"lp-consult-form\" data-form=\"consultation\" novalidate>\n                            \n                            <div style=\"position:absolute; left:-9999px;\" aria-hidden=\"true\">\n                                <label for=\"lp-website\">Website</label>\n                                <input type=\"text\" id=\"lp-website\" name=\"website\" tabindex=\"-1\" autocomplete=\"off\">\n                            </div>\n                            <input type=\"hidden\" name=\"page_url\" id=\"lp-page-url\">\n                            <input type=\"hidden\" name=\"referrer_url\" id=\"lp-referrer-url\">\n\n                            \n                            <div class=\"lp-form-step is-active\" data-step=\"1\">\n                                <h5 class=\"mb-3\">What are you looking to design?</h5>\n                                <div class=\"lp-choice-grid lp-choice-grid-4\" role=\"radiogroup\" aria-label=\"Project type\">\n                                    <div class=\"lp-choice\">\n                                        <input type=\"radio\" id=\"lp-type-home\" name=\"project_type\" value=\"Home\" required>\n                                        <label for=\"lp-type-home\">Home</label>\n                                    </div>\n                                    <div class=\"lp-choice\">\n                                        <input type=\"radio\" id=\"lp-type-villa\" name=\"project_type\" value=\"Villa\">\n                                        <label for=\"lp-type-villa\">Villa</label>\n                                    </div>\n                                    <div class=\"lp-choice\">\n                                        <input type=\"radio\" id=\"lp-type-apartment\" name=\"project_type\" value=\"Apartment\">\n                                        <label for=\"lp-type-apartment\">Apartment</label>\n                                    </div>\n                                    <div class=\"lp-choice\">\n                                        <input type=\"radio\" id=\"lp-type-office\" name=\"project_type\" value=\"Office / Commercial\">\n                                        <label for=\"lp-type-office\">Office</label>\n                                    </div>\n                                </div>\n                                <h5 class=\"mb-3\">Configuration</h5>\n                                <div class=\"lp-choice-grid lp-choice-grid-4\" role=\"radiogroup\" aria-label=\"Configuration\">\n                                    <div class=\"lp-choice\">\n                                        <input type=\"radio\" id=\"lp-config-2bhk\" name=\"configuration\" value=\"2 BHK\" required>\n                                        <label for=\"lp-config-2bhk\">2 BHK</label>\n                                    </div>\n                                    <div class=\"lp-choice\">\n                                        <input type=\"radio\" id=\"lp-config-3bhk\" name=\"configuration\" value=\"3 BHK\">\n                                        <label for=\"lp-config-3bhk\">3 BHK</label>\n                                    </div>\n                                    <div class=\"lp-choice\">\n                                        <input type=\"radio\" id=\"lp-config-4bhk\" name=\"configuration\" value=\"4 BHK+\">\n                                        <label for=\"lp-config-4bhk\">4 BHK+</label>\n                                    </div>\n                                    <div class=\"lp-choice\">\n                                        <input type=\"radio\" id=\"lp-config-other\" name=\"configuration\" value=\"Other\">\n                                        <label for=\"lp-config-other\">Other</label>\n                                    </div>\n                                </div>\n                                <div class=\"text-end\">\n                                    <button type=\"button\" class=\"btn btn-primary px-4 py-2\" data-lp-next=\"2\">Next</button>\n                                </div>\n                            </div>\n\n                            \n                            <div class=\"lp-form-step\" data-step=\"2\">\n                                <h5 class=\"mb-3\">Approximate budget for interiors</h5>\n                                <div class=\"lp-choice-grid\" role=\"radiogroup\" aria-label=\"Budget range\">\n                                    <div class=\"lp-choice\">\n                                        <input type=\"radio\" id=\"lp-budget-under15\" name=\"budget_range\" value=\"Under ₹15 Lakhs\" required>\n                                        <label for=\"lp-budget-under15\">Under ₹15L</label>\n                                    </div>\n                                    <div class=\"lp-choice\">\n                                        <input type=\"radio\" id=\"lp-budget-15-30\" name=\"budget_range\" value=\"₹15-30 Lakhs\">\n                                        <label for=\"lp-budget-15-30\">₹15-30L</label>\n                                    </div>\n                                    <div class=\"lp-choice\">\n                                        <input type=\"radio\" id=\"lp-budget-30-50\" name=\"budget_range\" value=\"₹30-50 Lakhs\">\n                                        <label for=\"lp-budget-30-50\">₹30-50L</label>\n                                    </div>\n                                    <div class=\"lp-choice\">\n                                        <input type=\"radio\" id=\"lp-budget-50plus\" name=\"budget_range\" value=\"₹50 Lakhs+\">\n                                        <label for=\"lp-budget-50plus\">₹50L+</label>\n                                    </div>\n                                </div>\n                                <h5 class=\"mb-3\">When are you looking to start?</h5>\n                                <div class=\"lp-choice-grid\" role=\"radiogroup\" aria-label=\"Timeline\">\n                                    <div class=\"lp-choice\">\n                                        <input type=\"radio\" id=\"lp-time-now\" name=\"timeline\" value=\"Immediately\" required>\n                                        <label for=\"lp-time-now\">Immediately</label>\n                                    </div>\n                                    <div class=\"lp-choice\">\n                                        <input type=\"radio\" id=\"lp-time-1-3\" name=\"timeline\" value=\"1-3 Months\">\n                                        <label for=\"lp-time-1-3\">1-3 Months</label>\n                                    </div>\n                                    <div class=\"lp-choice\">\n                                        <input type=\"radio\" id=\"lp-time-3-6\" name=\"timeline\" value=\"3-6 Months\">\n                                        <label for=\"lp-time-3-6\">3-6 Months</label>\n                                    </div>\n                                    <div class=\"lp-choice\">\n                                        <input type=\"radio\" id=\"lp-time-exploring\" name=\"timeline\" value=\"Just Exploring\">\n                                        <label for=\"lp-time-exploring\">Exploring</label>\n                                    </div>\n                                </div>\n                                <div class=\"d-flex justify-content-between\">\n                                    <button type=\"button\" class=\"btn btn-outline-primary px-4 py-2\" data-lp-back=\"1\">Back</button>\n                                    <button type=\"button\" class=\"btn btn-primary px-4 py-2\" data-lp-next=\"3\">Next</button>\n                                </div>\n                            </div>\n\n                            \n                            <div class=\"lp-form-step\" data-step=\"3\">\n                                <h5 class=\"mb-3\">Where should we send your quote?</h5>\n                                <div class=\"mb-3\">\n                                    <label class=\"form-label\" for=\"lp-full-name\">Full Name</label>\n                                    <input type=\"text\" class=\"form-control\" id=\"lp-full-name\" name=\"full_name\" maxlength=\"150\" required>\n                                    <div class=\"invalid-feedback\"></div>\n                                </div>\n                                <div class=\"mb-3\">\n                                    <label class=\"form-label\" for=\"lp-phone-number\">Phone Number</label>\n                                    <input type=\"tel\" class=\"form-control\" id=\"lp-phone-number\" name=\"phone_number\" maxlength=\"20\" required>\n                                    <div class=\"invalid-feedback\"></div>\n                                </div>\n                                <div class=\"mb-4\">\n                                    <label class=\"form-label\" for=\"lp-city\">City</label>\n                                    <input type=\"text\" class=\"form-control\" id=\"lp-city\" name=\"city\" maxlength=\"100\" required>\n                                    <div class=\"invalid-feedback\"></div>\n                                </div>\n                                <div class=\"d-flex justify-content-between align-items-center\">\n                                    <button type=\"button\" class=\"btn btn-outline-primary px-4 py-2\" data-lp-back=\"2\">Back</button>\n                                    <button type=\"submit\" class=\"btn btn-primary px-4 py-2\" id=\"lp-form-submit\" data-cta=\"form-submit\">Get My Free Quote</button>\n                                </div>\n                            </div>\n                        </form>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>"
    },
    {
      "type": "html",
      "html": "<section class=\"container-fluid py-5\" data-section=\"faq\">\n        <div class=\"container\">\n            <div class=\"text-center mb-5\">\n                <h2 class=\"h1 mb-0\">Frequently Asked <span class=\"text-uppercase text-primary bg-light px-2\">Questions</span></h2>\n            </div>\n            <div class=\"row justify-content-center\">\n                <div class=\"col-lg-9\">\n                    <div class=\"accordion\" id=\"faq-lp\">\n                        <div class=\"accordion-item\">\n                            <h3 class=\"accordion-header\">\n                                <button class=\"accordion-button\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#faq-lp-0\" aria-expanded=\"true\" aria-controls=\"faq-lp-0\">\n                                    How do I start a project with The Omega Group?\n                                </button>\n                            </h3>\n                            <div id=\"faq-lp-0\" class=\"accordion-collapse collapse show\" data-bs-parent=\"#faq-lp\">\n                                <div class=\"accordion-body\">Book a complimentary consultation through the form above or call us directly. We'll discuss your space, lifestyle, budget, and timeline, then follow up with a design direction and scope before any commercial terms are finalized.</div>\n                            </div>\n                        </div>\n                        <div class=\"accordion-item\">\n                            <h3 class=\"accordion-header\">\n                                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#faq-lp-1\" aria-expanded=\"false\" aria-controls=\"faq-lp-1\">\n                                    Is the first consultation really free?\n                                </button>\n                            </h3>\n                            <div id=\"faq-lp-1\" class=\"accordion-collapse collapse\" data-bs-parent=\"#faq-lp\">\n                                <div class=\"accordion-body\">Yes — the initial consultation, where we understand your space and requirements, doesn't cost anything. Detailed design work and execution are scoped and quoted separately once we understand your project.</div>\n                            </div>\n                        </div>\n                        <div class=\"accordion-item\">\n                            <h3 class=\"accordion-header\">\n                                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#faq-lp-2\" aria-expanded=\"false\" aria-controls=\"faq-lp-2\">\n                                    Is there a minimum project size?\n                                </button>\n                            </h3>\n                            <div id=\"faq-lp-2\" class=\"accordion-collapse collapse\" data-bs-parent=\"#faq-lp\">\n                                <div class=\"accordion-body\">No fixed minimum — we take on everything from a single modular kitchen or bespoke furniture piece to a full villa. Full-home turnkey interior design starts at ₹15 Lakhs+, scaling with size and customization.</div>\n                            </div>\n                        </div>\n                        <div class=\"accordion-item\">\n                            <h3 class=\"accordion-header\">\n                                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#faq-lp-3\" aria-expanded=\"false\" aria-controls=\"faq-lp-3\">\n                                    How are payments structured?\n                                </button>\n                            </h3>\n                            <div id=\"faq-lp-3\" class=\"accordion-collapse collapse\" data-bs-parent=\"#faq-lp\">\n                                <div class=\"accordion-body\">Payments are milestone-based, tied to project stages (design sign-off, material procurement, execution phases, and handover) rather than one lump sum. Your exact payment schedule is confirmed in writing before work begins, so there are no surprises.</div>\n                            </div>\n                        </div>\n                        <div class=\"accordion-item\">\n                            <h3 class=\"accordion-header\">\n                                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#faq-lp-4\" aria-expanded=\"false\" aria-controls=\"faq-lp-4\">\n                                    What happens if a project runs behind schedule?\n                                </button>\n                            </h3>\n                            <div id=\"faq-lp-4\" class=\"accordion-collapse collapse\" data-bs-parent=\"#faq-lp\">\n                                <div class=\"accordion-body\">We complete 90% of projects on schedule, but where a delay does happen (material lead times are the most common cause), we flag it as soon as we know and communicate a revised date — you're never left guessing.</div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>"
    },
    {
      "type": "html",
      "html": "<div class=\"container-fluid bg-primary newsletter p-0\" data-section=\"final-cta\">\n        <div class=\"container p-0\">\n            <div class=\"row g-0 align-items-center\">\n                <div class=\"col-md-5 ps-lg-0 text-start\">\n                    <img class=\"img-fluid w-100 h-100\" style=\"object-fit: cover;\" src=\"/img/cta-consultation.webp\"\n                        alt=\"Luxury bedroom suite with marble accent wall and custom dressing area designed by The Omega Group\" loading=\"lazy\" width=\"1478\" height=\"1057\">\n                </div>\n                <div class=\"col-md-7 py-5 newsletter-text\">\n                    <div class=\"p-5\">\n                        <span class=\"text-uppercase text-primary fw-bold d-block mb-2\" style=\"letter-spacing: 2px;\">Book Your Appointment</span>\n                        <h2 class=\"h1 mb-4\">Ready to See a Real Quote for Your Space?</h2>\n                        <p class=\"text-white mb-4\">No templates, no generic pricing — a design direction and itemised quote built around your actual home and budget.</p>\n                        <a href=\"#consult-form\" class=\"btn btn-primary py-3 px-5\" data-cta=\"final-get-quote\">Get My Free Quote</a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>"
    },
